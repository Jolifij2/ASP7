@model DataSourcesApp.Models.Student

@{
    ViewData["Title"] = "Удалить студента";
}

<h1>Удалить студента</h1>

<h3>Вы уверены, что хотите удалить этого студента?</h3>

<div>
    <p><strong>Имя:</strong> @Model.Name</p>
    <p><strong>Возраст:</strong> @Model.Age</p>
    <p><strong>Группа:</strong> @Model.Group</p>
    <p><strong>Город:</strong> @Model.City</p>
    <p><strong>Email:</strong> @Model.Email</p>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>
